{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build BitAdventure",
            "type": "shell",
            "command": "g++",
            "args": [
                "src/main.cpp",
                "src/Player.cpp",
                "src/Game.cpp",
                "-o", "main",
                "-std=c++17",
                "-ID:/library/SFML-3.0.2-windows-gcc-14.2.0-mingw-64-bit/SFML-3.0.2/include",
                "-LD:/library/SFML-3.0.2-windows-gcc-14.2.0-mingw-64-bit/SFML-3.0.2/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}